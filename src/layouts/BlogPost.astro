---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import { getPopupCampaign } from '../lib/popup-routes';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import CodeCopyScript from '../components/CodeCopyScript.astro';
import { POPUP_ENABLED, withPublication } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { slug: string; readingMinutes?: number };
const {
	title,
	description,
	pubDate,
	updatedDate,
	slug,
	seoTitle,
	seoDescription,
	socialTitle,
	readingMinutes = 1,
	hideDefaultNewsletter = false,
	showPopup = true,
	popupMode = 'email',
	popupHref,
	popupTitle,
	popupCopy,
	popupCta,
	noindex = false,
	related = [],
	faq = [],
	heroImage,
	layoutVariant,
} = Astro.props;
const socialImage = `/og/${slug}.png`;
const popupCampaign = getPopupCampaign(slug);
const socialImageAlt = `${socialTitle ?? title} — Ken Mazaika`;
const pageTitle = withPublication(seoTitle ?? title);
const canonicalURL = new URL(`/blog/${slug}/`, Astro.site);

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	image: new URL(socialImage, Astro.site).href,
	author: {
		'@type': 'Person',
		'@id': 'https://kenmazaika.com/#person',
		name: 'Ken Mazaika',
		url: 'https://kenmazaika.com/',
	},
	publisher: {
		'@type': 'Person',
		'@id': 'https://kenmazaika.com/#person',
		name: 'Ken Mazaika',
	},
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	mainEntityOfPage: canonicalURL.href,
};

// FAQPage schema — emitted only when the post defines `faq` in frontmatter.
const faqSchema = faq && faq.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
} : null;

// Masthead delivery: width-appropriate AVIF + WebP srcsets, one small JPEG
// fallback. The PNG source art stays in the repo; re-encoding it at display
// size cost 1.5-7.9 MB per variant, which is the defect this fixes.
const heroWidths = heroImage
	? [640, 960, 1280, 1600, 2000].filter((w) => w <= (heroImage.width ?? 2000))
	: [];
const heroAvif = heroImage
	? await Promise.all(heroWidths.map((width) => getImage({ src: heroImage, width, format: 'avif', quality: 50 })))
	: [];
const heroWebp = heroImage
	? await Promise.all(heroWidths.map((width) => getImage({ src: heroImage, width, format: 'webp', quality: 72 })))
	: [];
const toSrcset = (images: { src: string; attributes: { width?: number } }[]) =>
	images.map((img) => `${img.src} ${img.attributes.width}w`).join(', ');
const heroAvifSrcset = toSrcset(heroAvif);
const heroWebpSrcset = toSrcset(heroWebp);
const heroFallback = heroImage
	? await getImage({
			src: heroImage,
			width: Math.min(1280, heroImage.width ?? 1280),
			format: 'jpeg',
			quality: 78,
		})
	: null;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={seoDescription ?? description}
			image={socialImage}
			imageAlt={socialImageAlt}
			type="article"
			noindex={noindex}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
	</head>
	<body class={layoutVariant ? `variant-${layoutVariant}` : undefined}>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MF3D6HNN" height="0" width="0" style="display:none;visibility:hidden" aria-hidden="true"></iframe></noscript>
		<Header />
		<main id="main" class="article-shell">
			<article>
				{heroImage ? (
					<header class="article-masthead">
						<picture>
							<source type="image/avif" srcset={heroAvifSrcset} sizes="100vw" />
							<source type="image/webp" srcset={heroWebpSrcset} sizes="100vw" />
							<img
								src={heroFallback.src}
								width={heroFallback.attributes.width}
								height={heroFallback.attributes.height}
								alt=""
								class="masthead-bg"
								loading="eager"
								decoding="async"
								fetchpriority="high"
							/>
						</picture>
						<div class="masthead-scrim" />
						<div class="masthead-content">
							<div class="masthead-textblock">
								<a href="/blog" class="back-link back-link-light">Back to writing</a>
								<h1>{title}</h1>
								{description && <p class="article-deck">{description}</p>}
								<div class="article-meta">
									<span>By Ken Mazaika</span><span aria-hidden="true">·</span>
									<FormattedDate date={pubDate} /><span aria-hidden="true">·</span>
									<span>{readingMinutes} min read</span>
									{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
								</div>
							</div>
						</div>
					</header>
				) : (
					<header class="article-header">
						<a href="/blog" class="back-link">Back to writing</a>
						<h1>{title}</h1>
						{description && <p class="article-deck">{description}</p>}
						<div class="article-meta">
							<span>By Ken Mazaika</span><span aria-hidden="true">·</span>
							<FormattedDate date={pubDate} /><span aria-hidden="true">·</span>
							<span>{readingMinutes} min read</span>
							{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
						</div>
					</header>
				)}
				<div class="prose"><slot /></div>
				{related.length > 0 && (
					<nav class="related-posts" aria-label="Related reading">
						<h2>Related reading</h2>
						<ul>
							{related.map((item) => (
								<li><a href={item.url}>{item.title}</a></li>
							))}
						</ul>
					</nav>
				)}
				{!hideDefaultNewsletter && (
					<div class="article-signup">
						<NewsletterSignup placement="article_footer" variant="endnote" cta="Subscribe" />
					</div>
				)}
				{POPUP_ENABLED && popupCampaign !== 'none' && (
					<NewsletterPopup campaign={popupCampaign} />
				)}
				<footer class="article-footer">
					<p><strong>Ken Mazaika</strong> writes about engineering leadership, AI productivity, and practical systems.</p>
					<a href="/blog" class="back-link">Back to all posts</a>
				</footer>
			</article>
		</main>
		<Footer />
		<CodeCopyScript />
	</body>
</html>
