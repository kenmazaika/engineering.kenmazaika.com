		white-space: nowrap;
		color: var(--color-text-secondary);
		font-variant-numeric: tabular-nums;
		width: 8.5rem;
	}
	.ws-note {
		background: var(--color-accent-light);
		border-radius: var(--border-radius);
		padding: 0.9rem 1.1rem;
		font-size: 0.95rem;
		margin: 0;
	}
	.ws-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
	.ws-cols ul { margin: 0; padding-left: 1.1rem; }
