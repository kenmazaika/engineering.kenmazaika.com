---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="Ken Mazaika — an engineering manager documenting real AI-agent workflows, model choices, costs, and receipts." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<Header />
		<main class="about-content">
			<p class="eyebrow">About</p>
			<h1>I document what happens when AI agents meet real work.</h1>
			<p class="about-lead">I'm an engineering manager and operator. I run AI agents on practical work, keep the receipts, and write down what holds up outside the demo.</p>
			<hr />
			<p>The field notes cover workflows, model choices, costs, failures, and the systems I use to make agents useful. The longer essays examine how AI changes engineering organizations and why large software transformations fail.</p>
			<p>This is practitioner writing for engineers and technical leaders who want evidence, not demos.</p>
		</main>
		<Footer />
	</body>
</html>
