---
// /start/ — landing page for the five-part "Is Running Your Own AI Agent Worth It?" campaign.
// Staged only: do not deploy until Ken approves. Form writes metadata.sequence=agent-worth-5part.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const parts = [
	{
		title: 'What can you actually do with an AI agent?',
		body: 'The difference between a chat answer and a recurring job, using a real support loop: reproduce the bug, find the cause, check the fix, and write the knowledge-base entry.',
	},
	{
		title: 'What does it really cost?',
		body: 'A measured month: $50.93 for the normal setup, $30.93 of it metered, and the optional premium lane that pushed observed spending to $135.',
	},
	{
		title: 'Do you need expensive hardware?',
		body: 'The $175 used desktop with no GPU that runs an agent 24/7 — and why the computer you already own is enough to start.',
	},
	{
		title: 'Are cheaper AI models good enough?',
		body: 'Eleven models, five real tasks, identical prompts. Where the cheap daily driver held up, where the expensive models earned their price, and what to test on your own work.',
	},
	{
		title: 'How do you build your first useful agent?',
		body: 'Source, judgment, destination, reusable instructions, schedule — the five-part shape behind a Reddit-to-Airtable workflow that takes about an hour.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Is Running Your Own AI Agent Worth It? — Notes from the Loop"
			description="Five free emails covering what AI agents can actually do, what they cost, whether cheaper models work, and how to get started with OpenClaw or Hermes."
		/>
	</head>
	<body>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MF3D6HNN" height="0" width="0" style="display:none;visibility:hidden" aria-hidden="true"></iframe></noscript>
		<Header />
		<main id="main" class="start-page">
			<section class="hero">
				<p class="eyebrow">Five-part breakdown · Free</p>
				<h1>Is Running Your Own AI Agent Worth It?</h1>
				<p class="deck">
					Five free emails covering what AI agents can actually do, what they cost, whether cheaper
					models work, and how to get started with OpenClaw or Hermes.
				</p>

				<form
					class="signup"
					action="https://buttondown.com/api/emails/embed-subscribe/mazaika"
					method="post"
				>
					<label class="sr-only" for="email-hero">Your email</label>
					<input id="email-hero" type="email" name="email" placeholder="Your email" required />
					<input type="hidden" name="metadata__sequence" value="agent-worth-5part" />
					<input type="hidden" name="embed" value="1" />
					<button type="submit">Get the 5-Part Breakdown</button>
				</form>
				<p class="fine">One email per send, no drip until you confirm. Unsubscribe any time.</p>
			</section>

			<section class="parts" aria-labelledby="parts-title">
				<div class="parts-head">
					<h2 id="parts-title">The five-part breakdown</h2>
					<p>A practical look at the work, the bill, the hardware, and the models.</p>
				</div>

				<ol>
					{parts.map((part, i) => (
						<li>
							<span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<div>
								<h3>{part.title}</h3>
								<p>{part.body}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="closing" aria-labelledby="closing-title">
				<h2 id="closing-title">Start with the honest version.</h2>
				<p>
					Five emails, each with the real numbers and one concrete step. No testimonials, no
					projections.
				</p>
				<form
					class="signup signup-center"
					action="https://buttondown.com/api/emails/embed-subscribe/mazaika"
					method="post"
				>
					<label class="sr-only" for="email-bottom">Your email</label>
					<input id="email-bottom" type="email" name="email" placeholder="Your email" required />
					<input type="hidden" name="metadata__sequence" value="agent-worth-5part" />
					<input type="hidden" name="embed" value="1" />
					<button type="submit">Get the 5-Part Breakdown</button>
				</form>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.start-page {
		max-width: 900px;
		margin: 0 auto;
		padding: clamp(3rem, 7vw, 6rem) 1.5rem 5rem;
	}

	.hero { max-width: 720px; }

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 0 0 1.1rem;
		max-width: 18ch;
		font-family: var(--font-heading);
		font-size: clamp(2.6rem, 6vw, 4.3rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		font-weight: 600;
	}

	.deck {
		margin: 0 0 1.8rem;
		max-width: 58ch;
		color: var(--color-text-secondary);
		font-size: 1.08rem;
		line-height: 1.65;
	}

	.signup {
		display: flex;
		gap: 0.65rem;
		max-width: 480px;
	}

	.signup input[type='email'] {
		flex: 1;
		min-width: 0;
		padding: 0.82rem 0.9rem;
		font: inherit;
		font-size: 0.95rem;
		color: var(--color-text);
		background: var(--color-bg-card);
		border: 1px solid var(--color-border);
		border-radius: 7px;
	}

	.signup input[type='email']:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.12);
	}

	.signup button {
		padding: 0.82rem 1.1rem;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		color: #fff;
		background: var(--color-accent);
		border: 0;
		border-radius: 7px;
		cursor: pointer;
		white-space: nowrap;
	}

	.signup button:hover { background: var(--color-accent-hover); }

	.fine {
		margin: 0.7rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.84rem;
	}

	.parts {
		margin-top: clamp(3.5rem, 8vw, 6rem);
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-border);
	}

	.parts-head h2 {
		margin: 0 0 0.5rem;
		font-family: var(--font-heading);
		font-size: clamp(1.9rem, 3.5vw, 2.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.parts-head p {
		margin: 0 0 1.6rem;
		color: var(--color-text-secondary);
	}

	.parts ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.parts li {
		display: grid;
		grid-template-columns: 3.2rem 1fr;
		gap: 0.6rem;
		padding: 1.35rem 0;
		border-top: 1px solid var(--color-border-light);
	}

	.num {
		padding-top: 0.2rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.parts h3 {
		margin: 0 0 0.35rem;
		font-size: 1.06rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	.parts p {
		margin: 0;
		max-width: 66ch;
		color: var(--color-text-secondary);
		font-size: 0.97rem;
		line-height: 1.62;
	}

	.closing {
		margin-top: 3.5rem;
		padding: 2.6rem 2rem;
		border: 1px solid var(--color-border);
		border-radius: 14px;
		background: var(--color-accent-light);
		text-align: center;
	}

	.closing h2 {
		margin: 0 0 0.6rem;
		font-family: var(--font-heading);
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.closing p {
		margin: 0 auto 1.3rem;
		max-width: 52ch;
		color: var(--color-text-secondary);
	}

	.signup-center { margin: 0 auto; justify-content: center; }

	@media (max-width: 560px) {
		.signup { flex-direction: column; }
		.signup button { width: 100%; }
		.parts li { grid-template-columns: 2.2rem 1fr; }
		.closing { padding: 2rem 1.25rem; }
	}
</style>
