---
// Contextual signup for long reads.
// Rendered hidden at the end of the article, then moved after the second H2 by a
// tiny script so it lands at a natural section break instead of mid-paragraph.
// Only renders when the post is long enough to earn the interruption (>= 8 min).
interface Props {
	minutes?: number;
}

const { minutes = 0 } = Astro.props;
const eligible = minutes >= 8;
---

{
	eligible && (
		<div class="nl-inline-slot" data-nl-inline-slot hidden>
			<section class="newsletter-signup is-inline" aria-labelledby="nl-article-inline-heading" data-nl-placement="article_inline">
				<div class="newsletter-copy">
					<p class="newsletter-kicker">If you're building this too</p>
					<h2 id="nl-article-inline-heading">Get the next field note.</h2>
					<p>I send one email most Sundays: the workflow I ran, what it cost, and what broke. Real numbers, no roundup.</p>
				</div>
				<form
					action="https://buttondown.com/api/emails/embed-subscribe/mazaika"
					method="post"
					class="embeddable-buttondown-form"
					data-nl-form
					data-nl-placement="article_inline"
				>
					<label for="nl-article-inline-email">Email address</label>
					<div class="newsletter-fields">
						<input type="email" name="email" id="nl-article-inline-email" autocomplete="email" placeholder="you@example.com" required />
						<input type="hidden" name="embed" value="1" />
						<input type="hidden" name="tag" value="nl-article_inline" />
						<button type="submit">Send me the next note</button>
					</div>
					<p class="newsletter-note">One email a week, sometimes less. Unsubscribe in one click.</p>
				</form>
			</section>
		</div>
	)
}

<script>
	const slot = document.querySelector<HTMLElement>('[data-nl-inline-slot]');
	const prose = document.querySelector<HTMLElement>('.prose');
	if (slot && prose) {
		const headings = Array.from(prose.querySelectorAll<HTMLElement>('h2'));
		const anchor = headings[1];
		// Skip if the next block is a code sample — never split a tutorial.
		const next = anchor?.nextElementSibling;
		if (anchor && !(next && (next.tagName === 'PRE' || next.querySelector('pre')))) {
			slot.hidden = false;
			anchor.insertAdjacentElement('afterend', slot.firstElementChild as Element);
			slot.remove();
		}
	}
</script>
