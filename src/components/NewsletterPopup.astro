---
// NewsletterPopup.astro
// Slide-up (scroll depth) + exit-intent capture card, wired per post via frontmatter.
// Modes:
//   - 'email' (default): Buttondown email capture (showPopup: true)
//   - 'link': CTA card linking to a post (showPopup + popupMode: link + popupHref)
// Test control: append ?popup=1 to the URL to bypass the 7-day frequency cap.
interface Props {
	mode?: 'email' | 'link';
	href?: string;
	title?: string;
	copy?: string;
	cta?: string;
}

const { mode = 'email', href = '/blog/obsidian-vault-on-your-phone/', title, copy, cta } = Astro.props;

const isLink = mode === 'link';
const kicker = 'The 7-day vault course';
// Retargeted 2026-10-24 from the Hermes Kit scorecard to the 7-email vault course.
// Email mode enrolls the subscriber in tag `jdak`, which is the course automation trigger.
const popupTitle =
	title ??
	(isLink
		? 'Set up a vault your agent can actually use.'
		: 'Get the 7-day vault course.');
const popupCopy =
	copy ??
	(isLink
		? 'A seven-email course on an Obsidian vault an agent can navigate and file into: notes on your phone, one folder per project, an inbox the agent writes to. One action a day.'
		: 'Seven emails, one action each. Get the vault onto your phone, give every project one folder, build an inbox your agent can write to, then a weekly pass that keeps it legible. Nothing to configure.');
const popupCta = cta ?? (isLink ? 'Start with day 1' : 'Send me day 1');
---

<div id="nl-popup" class="nl-popup" role="dialog" aria-modal="false" aria-label={kicker} aria-hidden="true">
	<div class="nl-popup-card">
		<button id="nl-popup-close" class="nl-popup-close" type="button" aria-label="Close popup">✕</button>
		<p class="nl-popup-kicker">{kicker}</p>
		<h2 class="nl-popup-title">{popupTitle}</h2>
		<p class="nl-popup-copy">{popupCopy}</p>
		{
			isLink ? (
				<a class="nl-popup-cta" href={href}>{popupCta}<span aria-hidden="true"> →</span></a>
			) : (
				<form
					class="nl-popup-form"
					action="https://buttondown.com/api/emails/embed-subscribe/mazaika"
					method="post"
					data-nl-form
					data-nl-placement="popup_course"
				>
					<label class="nl-popup-label" for="nl-popup-email">Email address</label>
					<div class="nl-popup-fields">
						<input type="email" name="email" id="nl-popup-email" autocomplete="email" placeholder="you@example.com" required />
						<input type="hidden" name="embed" value="1" />
						<input type="hidden" name="tag" value="jdak" />
						<input type="hidden" name="metadata__optin" value="course" />
						<button type="submit">{popupCta}</button>
					</div>
				</form>
			)
		}
	</div>
</div>

<style>
	.nl-popup {
		position: fixed;
		z-index: 60;
		bottom: 1rem;
		left: 1rem;
		right: 1rem;
		max-width: 22rem;
		margin: 0 auto;
		pointer-events: none;
	}
	@media (min-width: 40rem) {
		.nl-popup {
			left: auto;
			right: 1.5rem;
			margin: 0;
		}
	}
	.nl-popup-card {
		pointer-events: auto;
		position: relative;
		background: var(--color-bg-card);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		box-shadow: 0 12px 32px rgb(26 24 20 / 0.16);
		padding: 1.25rem 1.25rem 1rem;
		transform: translateY(calc(100% + 2rem));
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.nl-popup.is-open .nl-popup-card {
		transform: translateY(0);
	}
	.nl-popup-close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		width: 1.75rem;
		height: 1.75rem;
		display: grid;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--color-text-secondary);
		font-size: 0.85rem;
		cursor: pointer;
		border-radius: 0.375rem;
	}
	.nl-popup-close:hover {
		background: var(--color-bg-secondary);
		color: var(--color-text);
	}
	.nl-popup-kicker {
		margin: 0 0 0.25rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}
	.nl-popup-title {
		margin: 0 0 0.35rem;
		font-family: Newsreader, Georgia, serif;
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.15;
		color: var(--color-text);
	}
	.nl-popup-copy {
		margin: 0 0 0.75rem;
		font-size: 0.85rem;
		line-height: 1.45;
		color: var(--color-text-secondary);
	}
	.nl-popup-label {
		display: block;
		margin-bottom: 0.3rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-text);
	}
	.nl-popup-fields {
		display: flex;
		gap: 0.5rem;
	}
	.nl-popup-fields input[type='email'] {
		flex: 1;
		min-width: 0;
		padding: 0.5rem 0.65rem;
		font: inherit;
		font-size: 0.85rem;
		color: var(--color-text);
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
	}
	.nl-popup-fields input[type='email']:focus {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
		border-color: transparent;
	}
	.nl-popup-fields button,
	.nl-popup-cta {
		display: block;
		width: 100%;
		padding: 0.55rem 0.85rem;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		text-align: center;
		text-decoration: none;
		color: #fff;
		background: var(--color-text);
		border: 0;
		border-radius: 0.375rem;
		cursor: pointer;
		white-space: nowrap;
	}
	.nl-popup-fields button:hover,
	.nl-popup-cta:hover {
		background: var(--color-accent);
		color: #fff;
	}
	.nl-popup-fields {
		display: flex;
		gap: 0.5rem;
	}
	.nl-popup-fields button {
		width: auto;
		flex-shrink: 0;
	}
</style>

<script>
	const popup = document.getElementById('nl-popup');
	const closeBtn = document.getElementById('nl-popup-close');
	if (!popup || !closeBtn) throw new Error('NewsletterPopup: missing elements');

	const KEY = 'km-nl-popup-seen';
	const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;
	const force = new URLSearchParams(window.location.search).get('popup') === '1';
	let shown = false;

	function isEligible() {
		if (force) return true;
		const last = Number(localStorage.getItem(KEY) || 0);
		return Date.now() - last > SEVEN_DAYS;
	}

	function cleanup() {
		window.removeEventListener('scroll', onScroll, { capture: true });
		document.removeEventListener('mouseout', onMouseOut);
	}

	function show() {
		if (shown || !isEligible()) return;
		shown = true;
		localStorage.setItem(KEY, String(Date.now()));
		popup.classList.add('is-open');
		popup.setAttribute('aria-hidden', 'false');
		closeBtn.focus();
		cleanup();
	}

	function hide() {
		popup.classList.remove('is-open');
		popup.setAttribute('aria-hidden', 'true');
		cleanup();
	}

	function onScroll() {
		const doc = document.documentElement;
		const progress = (window.scrollY + window.innerHeight) / doc.scrollHeight;
		if (progress >= 0.55) show();
	}

	function onMouseOut(event) {
		// Exit intent: cursor leaves the window through the top edge.
		if (!event.relatedTarget && event.clientY <= 0) show();
	}

	closeBtn.addEventListener('click', hide);
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') hide();
	});
	window.addEventListener('scroll', onScroll, { passive: true, capture: true });
	document.addEventListener('mouseout', onMouseOut);
</script>
