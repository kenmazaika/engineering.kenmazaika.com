---
import { SITE_NAME } from '../consts';
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<div class="content">
		<a href="/" class="site-title"><span class="site-mark" aria-hidden="true">
				<svg viewBox="0 0 32 32" width="19" height="19" fill="none">
					<circle cx="16" cy="16" r="14.5" stroke="currentColor" stroke-width="1.6" />
					<path d="M9 19c2.2-5.5 4.4-5.5 6.6 0s4.4 5.5 6.6 0" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
					<circle cx="16" cy="9.5" r="1.6" fill="currentColor" />
				</svg>
			</span><span>{SITE_NAME}</span></a>
		<nav class="site-nav" aria-label="Primary">
			<a href="/start/" aria-current={Astro.url.pathname === '/start/' ? 'page' : undefined}>Start here</a>
			<a href="/blog" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
			<a href="/subscribe/" aria-current={Astro.url.pathname === '/subscribe/' ? 'page' : undefined}>Subscribe</a>
			<a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a>
			<a href="/loop-breakdown/" aria-current={Astro.url.pathname === '/loop-breakdown/' ? 'page' : undefined}>Course</a>
		</nav>
		<div class="site-nav-mobile">
			<a href="/start/" aria-current={Astro.url.pathname === '/start/' ? 'page' : undefined}>Start here</a>
			<details>
				<summary>Menu</summary>
				<nav aria-label="More destinations">
					<a href="/subscribe/">Subscribe</a>
					<a href="/blog">Blog</a>
					<a href="/about">About</a>
					<a href="/loop-breakdown/">Course</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	.skip-link {
		position: fixed;
		top: .75rem;
		left: .75rem;
		z-index: 1000;
		padding: .65rem .9rem;
		color: #fff;
		background: var(--color-accent);
		border-radius: var(--border-radius);
		font-weight: 600;
		transform: translateY(-200%);
	}
	.skip-link:focus { transform: translateY(0); }
</style>
